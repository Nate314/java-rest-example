# Copy to .env and change every value before any non-local use.
# docker compose reads .env automatically. If .env is absent, the defaults
# below (also baked into docker-compose.yml) are used, which is for local
# demo use only. Values must not contain single quotes or spaces.

MYSQL_ROOT_PASSWORD=change-me-root-password
DB_USER=app
DB_PASSWORD=change-me-app-password

# HMAC secret for signing JWTs, at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# Set to false to disable Swagger UI and the OpenAPI document.
SWAGGER_ENABLED=true

# Host ports. MySQL and phpMyAdmin are bound to 127.0.0.1 only.
APP_PORT=8080
PMA_PORT=8082
MYSQL_PORT=3306
